function decode(source text) -> result<list<text>,text> { return decodeJson(source) }

function countMatches(source text, expectedCount integer) -> boolean {
  let decoded = decode(source)
  if isOk(decoded) {
    let values = decoded.value
    var count integer = 0
    var found boolean = false
    for value in values {
      count = count + 1
      if value == "β" { found = true }
    }
    return count == expectedCount and (expectedCount == 0 or found)
  } else { return false }
}

function longWire() -> text { return encodeJson(["alpha", "alpha", "β", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha", "alpha"]) }

function main() -> boolean {
  let escaped = decode("{\"version\":1,\"kind\":\"list\",\"elementType\":{\"kind\":\"primitive\",\"name\":\"text\"},\"items\":[{\"version\":1,\"kind\":\"text\",\"value\":\"\\u03b2\"}]}")
  let mismatch = decode("{\"version\":1,\"kind\":\"list\",\"elementType\":{\"kind\":\"primitive\",\"name\":\"integer\"},\"items\":[{\"version\":1,\"kind\":\"integer\",\"value\":\"4\"}]}")
  return countMatches("{\"version\":1,\"kind\":\"list\",\"elementType\":{\"kind\":\"primitive\",\"name\":\"text\"},\"items\":[{\"version\":1,\"kind\":\"text\",\"value\":\"alpha\"},{\"version\":1,\"kind\":\"text\",\"value\":\"β\"}]}", 2) and
    countMatches("{\"version\":1,\"kind\":\"list\",\"elementType\":{\"kind\":\"primitive\",\"name\":\"text\"},\"items\":[]}", 0) and isErr(mismatch)
    and countMatches("__BMEC_LONG_TEXT_LIST__", 20) and isOk(escaped) and countMatches("{\"version\":1,\"kind\":\"list\",\"elementType\":{\"kind\":\"primitive\",\"name\":\"text\"},\"items\":[{\"version\":1,\"kind\":\"text\",\"value\":\"\\u03b2\"}]}", 1)
}
