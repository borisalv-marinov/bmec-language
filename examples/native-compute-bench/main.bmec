app NativeComputeBenchmark

function collatzSteps(initial integer) -> integer {
  var value integer = initial
  var steps integer = 0
  while value > 1 {
    if value % 2 == 0 {
      value = value / 2
    } else {
      value = value * 3 + 1
    }
    steps = steps + 1
  }
  return steps
}

function main() -> integer {
  return collatzSteps(837799)
}
