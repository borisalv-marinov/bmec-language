program = { import | declaration } ;
import = "import", "{", identifier, { ",", identifier }, "}", "from", string ;
declaration = app | model | record | enum | page | style | api | function ;
app = "app", identifier ;
model = ("model" | "type"), identifier, "{", { field }, "}" ;
record = "type", identifier, "{", { field }, "}" ;
enum = "enum", identifier, "{", enum-variant, { [ "," ], enum-variant }, "}" ;
enum-variant = identifier, [ "(", type, ")" ] ;
field = identifier, type, { modifier } ;
page = "page", identifier, "{", { crud }, "}" ;
crud = "crud", identifier ;
style = "style", identifier, { identifier } ;
api = "api", "/", identifier, "from", identifier ;
function = "function", identifier, "(", [ parameters ], ")", "->", type, "{", { statement }, "}" ;
parameters = parameter, { ",", parameter } ;
parameter = identifier, type ;
statement = let | return | if | for ;
let = "let", identifier, [ type ], "=", expression ;
return = "return", expression ;
if = "if", expression, "{", { statement }, "}", [ "else", "{", { statement }, "}" ] ;
for = "for", identifier, "in", expression, "{", { statement }, "}" ;
expression = literal | list | record-value | identifier | call | index | field-access | match | lambda | unary | binary | "(", expression, ")" ;
lambda = "lambda", "(", [ parameters ], ")", "->", type, "{", { statement }, "}" ;
match = "match", expression, "{", match-arm, { [ "," ], match-arm }, "}" ;
match-arm = identifier, [ "(", identifier, ")" ], "=>", expression ;
list = "[", [ expression, { ",", expression } ], "]" ;
record-value = identifier, "{", identifier, ":", expression, { identifier, ":", expression }, "}" ;
call = identifier, "(", [ expression, { ",", expression } ], ")" ;
index = expression, "[", expression, "]" ;
field-access = expression, ".", identifier ;
unary = ("-" | "not"), expression ;
binary = expression, operator, expression ;
operator = "+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | "<=" | ">" | ">=" | "and" | "or" ;
literal = string | number | "true" | "false" | "none" ;
type = primitive | identifier | "list", "<", type, ">", [ "?" ] | primitive, "?" | identifier, "?" ;
primitive = "text" | "number" | "integer" | "boolean" | "money" | "date" | "datetime" | "id" ;
modifier = "required" | "unique" | "default", (identifier | number | string) ;
identifier = letter, { letter | digit | "_" | "-" } ;
# Milestone B additions (surface forms accepted by the current parser)
type-ref = primitive | named | list-type | result-type | optional-type ;
list-type = "list" "<" type-ref ">" ;
result-type = "result" "<" type-ref "," type-ref ">" ;
optional-type = type-ref "?" ;
stdlib-call = "trim" | "lower" | "upper" | "textLength" | "textContains" | "startsWith" | "endsWith" | "absInt" | "absNumber" | "minInt" | "maxInt" | "floor" | "ceil" | "round" | "first" | "last" | "ok" | "err" | "isOk" | "isErr" ;
