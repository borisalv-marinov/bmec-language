# Copy to a private env file or supply these through your deployment manager.
# The secret files must stay outside source control and be readable by the
# postgres process and the unprivileged app user (UID 1000).
POSTGRES_DB=bmec
POSTGRES_USER=bmec
POSTGRES_PASSWORD_SECRET_FILE=./deploy-secrets/postgres_password
BMEC_POSTGRES_URL_SECRET_FILE=./deploy-secrets/postgres_url
BMEC_HOST_BIND_ADDRESS=127.0.0.1
BMEC_HOST_PORT=3000
BMEC_SECURITY_MODE=production
BMEC_AUTH_DEFAULT_POLICY=role:admin
BMEC_ALLOWED_ORIGINS=https://app.example.com
BMEC_MAX_BODY_BYTES=1000000
BMEC_MAX_HEADER_BYTES=16384
